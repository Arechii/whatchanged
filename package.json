{
	"name": "@arechi/whatchanged",
	"version": "0.1.1",
	"description": "Read the release notes for every outdated dependency, between the version you have and the latest",
	"keywords": [
		"changelog",
		"cli",
		"dependencies",
		"outdated",
		"pnpm",
		"release-notes",
		"upgrade"
	],
	"homepage": "https://github.com/Arechii/whatchanged#readme",
	"bugs": "https://github.com/Arechii/whatchanged/issues",
	"license": "MIT",
	"author": "Arechi",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Arechii/whatchanged.git"
	},
	"bin": {
		"whatchanged": "dist/cli.mjs"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"check": "oxlint --fix . && oxfmt --write .",
		"check:ci": "oxlint --deny-warnings . && oxfmt --check .",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"prepack": "pnpm build",
		"changeset": "changeset",
		"version-packages": "changeset version && oxfmt --write CHANGELOG.md package.json",
		"release": "pnpm build && changeset publish",
		"knip": "knip"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/semver": "^7.8.0",
		"ink": "^8.0.0",
		"ink-testing-library": "^4.0.0",
		"knip": "^6.41.0",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"oxlint-tsgolint": "~7.0.2004",
		"react": "^19.3.0",
		"semver": "^7.8.5",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3",
		"wrap-ansi": "^10.0.2"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@12.9.1"
}
